    "escape-string-regexp": "5.0.0",
    "execa": "9.6.1",
    "flexver": "1.1.1",
    "handlebars": "4.7.8",
    "mem": "10.0.0",
    "multimatch": "8.0.0",
    "p-map": "7.0.4",
    "p-queue": "9.1.0",
    "tempy": "3.2.0",
    "undici": "7.24.5",
    "walkdir": "0.4.1",
    "yargs": "18.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@types/node": "25.5.0",
